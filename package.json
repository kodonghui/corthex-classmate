{
  "name": "corthex-classmate",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/run-all-tests.mjs",
    "test:all": "node scripts/run-all-tests.mjs --with-e2e",
    "test:vitest": "node scripts/run-all-tests.mjs vitest",
    "test:cargo": "node scripts/run-all-tests.mjs cargo",
    "test:node": "node scripts/run-all-tests.mjs node",
    "test:e2e": "node scripts/run-all-tests.mjs e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "generate": "pnpm --filter @classmate/contracts generate",
    "package:host": "node installer/windows/build-host.mjs",
    "package:extension": "node installer/windows/package-extension.mjs",
    "package:friend": "node installer/windows/package-friend.mjs",
    "install:dry-run": "node installer/windows/install.mjs",
    "smoke:host": "node installer/windows/smoke-host.mjs"
  }
}
