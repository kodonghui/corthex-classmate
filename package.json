{
  "name": "corthex-classmate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "generate": "pnpm --filter @classmate/contracts generate",
    "package:host": "node installer/windows/build-host.mjs",
    "package:extension": "node installer/windows/package-extension.mjs",
    "install:dry-run": "node installer/windows/install.mjs",
    "smoke:host": "node installer/windows/smoke-host.mjs"
  }
}
