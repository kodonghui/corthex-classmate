{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.corthex.dev/classmate/activity-card.schema.json",
  "title": "ActivityCard",
  "description": "다섯 학습 슬롯 중 한 자리를 채우는 근거 기반 활동입니다.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/Id" },
    "slot": { "$ref": "#/definitions/ActivitySlot" },
    "kind": { "$ref": "#/definitions/ActivityKind" },
    "prompt": {
      "description": "답을 보기 전에 사용자가 수행할 질문이나 상황입니다.",
      "type": "string",
      "minLength": 1
    },
    "evidenceRefIds": {
      "description": "활동을 만든 근거 식별자이며 한 개 이상이어야 합니다.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/Id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "hints": {
      "description": "사용자가 단계별로 열 수 있는 힌트입니다.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "answer": {
      "description": "시도 뒤에만 공개할 모범 응답이나 해설입니다.",
      "type": "string",
      "minLength": 1
    },
    "variation": {
      "description": "조건을 바꿔 다시 적용하게 하는 선택적 변형 질문입니다.",
      "type": "string",
      "minLength": 1
    },
    "attempts": {
      "description": "답 공개 전 시도와 그 뒤 자기 수정을 시간 순서로 담습니다.",
      "type": "array",
      "items": { "$ref": "#/definitions/ActivityAttempt" }
    }
  },
  "required": ["id", "slot", "kind", "prompt", "evidenceRefIds", "hints", "answer", "attempts"],
  "additionalProperties": false,
  "definitions": {
    "ActivitySlot": {
      "title": "ActivitySlot",
      "description": "예측 가능한 다섯 활동의 고정 순서 자리입니다.",
      "type": "string",
      "enum": ["RECALL", "EXPLAIN", "INSPECT", "APPLY", "TRANSFER"]
    },
    "ActivityKind": {
      "title": "ActivityKind",
      "description": "활동이 요구하는 수행 형식입니다.",
      "type": "string",
      "enum": ["question", "worked-example", "simulation"]
    },
    "ActivityAttempt": {
      "title": "ActivityAttempt",
      "description": "답을 공개하기 전 사용자가 직접 낸 한 번의 시도와 후속 기록입니다.",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "startedAt": { "$ref": "common.schema.json#/definitions/IsoDateTime" },
        "submittedAt": { "$ref": "common.schema.json#/definitions/IsoDateTime" },
        "response": {
          "description": "사용자가 답 공개 전에 직접 낸 응답입니다.",
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "description": "시도 당시 사용자가 표시한 확신 정도이며 1이 가장 낮고 5가 가장 높습니다.",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "hintLevel": {
          "description": "이 시도 전에 연 힌트의 가장 높은 단계이며 힌트를 안 봤으면 0입니다.",
          "type": "integer",
          "minimum": 0
        },
        "revealedAt": {
          "description": "모범 응답을 공개한 시각입니다. 제출 전에는 두지 않습니다.",
          "type": "string",
          "format": "date-time"
        },
        "selfCorrection": {
          "description": "피드백이나 답 공개 뒤 사용자가 고친 내용입니다.",
          "type": "string",
          "minLength": 1
        },
        "feedback": {
          "description": "이 시도에 대한 근거 기반 피드백입니다.",
          "type": "string",
          "minLength": 1
        },
        "nextAttemptAt": {
          "description": "다음 회상 또는 변형 시도를 예약한 시각입니다.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "startedAt", "submittedAt", "response", "confidence", "hintLevel"],
      "additionalProperties": false
    }
  }
}
