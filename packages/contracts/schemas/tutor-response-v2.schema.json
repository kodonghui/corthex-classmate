{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.corthex.dev/classmate/tutor-response-v2.schema.json",
  "title": "TutorResponseV2",
  "description": "도메인별 고정 답 칸 대신 동적 절을 담고 질문과 근거를 연결하는 튜터 응답입니다.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/Id" },
    "questionId": { "$ref": "common.schema.json#/definitions/Id" },
    "createdAt": { "$ref": "common.schema.json#/definitions/IsoDateTime" },
    "conclusion": {
      "description": "먼저 보여 줄 한 문장 결론입니다.",
      "type": "string",
      "minLength": 1
    },
    "evidenceRefIds": {
      "description": "이 응답 전체를 뒷받침하는 자료·순간·자산 식별자입니다.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/Id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "sections": {
      "description": "프로필에 맞춰 동적으로 구성한 상세 절입니다.",
      "type": "array",
      "items": { "$ref": "#/definitions/TutorResponseSectionV2" }
    },
    "providerId": {
      "description": "응답을 만든 제공자 어댑터 식별자입니다.",
      "type": "string",
      "minLength": 1
    },
    "model": {
      "description": "제공자가 실제로 보고한 모델 이름입니다.",
      "type": "string",
      "minLength": 1
    },
    "status": {
      "description": "응답 생성의 최종 또는 대기 상태입니다.",
      "type": "string",
      "enum": ["completed", "queued", "error", "cancelled"]
    },
    "warnings": {
      "description": "응답을 표시할 때 함께 알려야 하는 제한이나 경고입니다.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "$ref": "material-ref.schema.json#/definitions/VerificationMetadataV2"
    }
  },
  "required": [
    "id",
    "questionId",
    "createdAt",
    "conclusion",
    "evidenceRefIds",
    "sections",
    "providerId",
    "status"
  ],
  "additionalProperties": false,
  "definitions": {
    "TutorResponseSectionV2": {
      "title": "TutorResponseSectionV2",
      "description": "튜터 응답의 동적 상세 절 한 개입니다.",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "title": {
          "description": "절의 화면 제목입니다.",
          "type": "string",
          "minLength": 1
        },
        "content": {
          "description": "실행하지 않고 텍스트로 렌더링할 절 본문입니다.",
          "type": "string",
          "minLength": 1
        },
        "evidenceRefIds": {
          "description": "이 절만 뒷받침하는 선택적 근거 식별자입니다.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/Id" },
          "uniqueItems": true
        }
      },
      "required": ["id", "title", "content"],
      "additionalProperties": false
    }
  }
}
