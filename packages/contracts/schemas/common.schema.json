{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.corthex.dev/classmate/common.schema.json",
  "title": "Common",
  "description": "여러 계약이 함께 쓰는 기본 조각(식별자·시각·교시·자료 나이·상태 이름)을 모아 둔 정의 묶음입니다.",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "title": "Id",
      "description": "한 항목을 가리키는 문자열 식별자입니다.",
      "type": "string",
      "minLength": 1
    },
    "IsoDateTime": {
      "title": "IsoDateTime",
      "description": "ISO-8601 시각 문자열입니다. 보기 2026-09-02T10:32:18+09:00",
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "PeriodId": {
      "title": "PeriodId",
      "description": "교시 세션 식별자입니다. 보기 2026-09-02-p3",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-p[1-9][0-9]*$"
    },
    "SourceAges": {
      "title": "SourceAges",
      "description": "질문을 붙잡은 순간 각 자료가 몇 초 전 것인지 담습니다. 자료가 없으면 null 입니다.",
      "type": "object",
      "properties": {
        "transcriptSec": {
          "description": "전사가 몇 초 전 것인지입니다.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "screenSec": {
          "description": "화면 프레임이 몇 초 전 것인지입니다.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "editorSec": {
          "description": "편집기 문맥이 몇 초 전 것인지입니다.",
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["transcriptSec", "screenSec", "editorSec"],
      "additionalProperties": false
    },
    "TutorState": {
      "title": "TutorState",
      "description": "앱이 통제하는 튜터 상태기계의 상태 이름입니다.",
      "type": "string",
      "enum": [
        "CAPTURE",
        "ANSWER_MINIMAL",
        "EXIT_RECALL",
        "FEEDBACK",
        "FADE_SUPPORT",
        "DELAYED_CHECK"
      ]
    }
  }
}
