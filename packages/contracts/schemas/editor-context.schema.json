{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.corthex.dev/classmate/editor-context.schema.json",
  "title": "EditorContext",
  "description": "수업 모드에서 읽기만 한 편집기 화면 문맥입니다. 파일을 고치거나 실행하지 않습니다.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/Id" },
    "periodId": { "$ref": "common.schema.json#/definitions/PeriodId" },
    "capturedAt": { "$ref": "common.schema.json#/definitions/IsoDateTime" },
    "filePath": {
      "description": "프로젝트 뿌리를 기준으로 한 파일 경로입니다.",
      "type": "string",
      "minLength": 1
    },
    "language": {
      "description": "파일의 언어 이름입니다. 보기 java",
      "type": "string",
      "minLength": 1
    },
    "visibleRange": {
      "title": "VisibleRange",
      "description": "화면에 보이던 줄 범위입니다. 줄 번호는 1 부터 셉니다.",
      "type": "object",
      "properties": {
        "startLine": {
          "description": "보이던 첫 줄 번호입니다.",
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "description": "보이던 마지막 줄 번호입니다.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["startLine", "endLine"],
      "additionalProperties": false
    },
    "excerpt": {
      "description": "보이던 범위의 코드 발췌입니다.",
      "type": "string"
    },
    "caretLine": {
      "description": "커서가 있던 줄 번호입니다. 알 수 없으면 넣지 않습니다.",
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "description": "이 문맥이 어디에서 왔는지입니다.",
      "type": "string",
      "enum": ["intellij-mcp", "fixture"]
    }
  },
  "required": [
    "id",
    "periodId",
    "capturedAt",
    "filePath",
    "language",
    "visibleRange",
    "excerpt",
    "source"
  ],
  "additionalProperties": false
}
