{
  "name": "@classmate/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Corthex Classmate 계약 정본 · JSON Schema 에서 타입을 만듭니다",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "schemas",
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "pretest": "pnpm run generate",
    "test": "vitest run",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
