{
  "manifest_version": 3,
  "name": "Classmate Orca · Meet",
  "description": "Explicitly select one Meet tab for requested Classmate screenshots.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "nativeMessaging"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Classmate Orca: select this Meet tab"}
}
