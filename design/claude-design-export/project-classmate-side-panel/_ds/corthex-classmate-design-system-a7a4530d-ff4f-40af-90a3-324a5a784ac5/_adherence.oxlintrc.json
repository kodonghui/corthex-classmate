{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/classmate/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/surfaces/**",
              "ui_kits/sidepanel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Gothic A1|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Gothic A1, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|meta|type|content|code|caption|source|highlightLines|lineNumbers|speaker|time|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<AnswerSection> doesn't accept that prop. Declared props: id, label, icon, meta, type, content, code, caption, source, highlightLines, lineNumbers, speaker, time, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerSection'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|code|quote)$/]",
        "message": "<AnswerSection> type must be one of 'text' | 'code' | 'quote'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|soft|live|paused|off)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'soft' | 'live' | 'paused' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|description|action|onAction|secondaryAction|onSecondaryAction|onDismiss|icon|className|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, title, description, action, onAction, secondaryAction, onSecondaryAction, onDismiss, icon, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paused|off|info|live)$/]",
        "message": "<Banner> tone must be one of 'paused' | 'off' | 'info' | 'live'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|full|loading|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, full, loading, children."
      },
